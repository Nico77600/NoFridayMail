# Line endings are normalized to LF in the repository.
* text=auto eol=lf

# Binaries
*.png binary

# Documentation, not code (language statistics).
*.md linguist-documentation
package/docs/** linguist-documentation

# PowerShell files of the package that the owner signs (Authenticode) before a release: Git must keep their exact
# bytes (CRLF included). The signature is added by the owner's procedure, outside CI; until then they are plain text.
# Developer files (tests, CI scripts, tools\New-NoFridayMailPackage.ps1) are not signed: they follow the LF rule above.
package/tools/Deploy-NoFridayMail.ps1 -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
package/tools/New-NoFridayMailEnvironment.ps1 -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
package/tools/lib/Deploy-Checks.ps1 -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol
package/tools/Test-PackageIntegrity.ps1 -text whitespace=blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol

# Exact bytes for the documents hashed in the release PackageIntegrity.psd1 manifest.
package/docs/**/*.html -text
package/README.md -text
package/THIRD-PARTY-NOTICES.md -text
# The root CHANGELOG.md is added to the release ZIP by tools/New-NoFridayMailPackage.ps1 and hashed there: exact bytes too.
/CHANGELOG.md -text

# "Download ZIP" and `git archive` ship the package folder only: exactly what is needed to deploy and use the add-in
# (the release ZIP is built from the same subtree). Everything else stays in the repository. A new file at the root
# must be listed here (tests/package-export.test.js checks the archive).
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/CHANGELOG.md export-ignore
/LICENSE export-ignore
/PROVENANCE.md export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
/assets export-ignore
/package-lock.json export-ignore
/package.json export-ignore
/tests export-ignore
/tools export-ignore
